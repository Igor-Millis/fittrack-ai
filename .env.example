# Copie para .env para alterar padrões. Tudo é opcional.
# Banco de dados (padrão: data/fittrack.db)
# FITTRACK_DB=data/fittrack.db

# IA local (Ollama) — desativada por padrão; também pode ser ligada na página Configurações
FITTRACK_AI_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=90
